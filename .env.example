# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

+# Allowed hosts (comma-separated in production setup)
+# Example: ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

+# CORS
+# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

+# Google GenAI
GEMINI_API_KEY=your-gemini-api-key

+# Optional model tuning (currently hardcoded in code, kept for future hardening)
+# GEMINI_MODEL_NAME=gemini-3.1-flash-lite